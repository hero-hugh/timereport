{
	"$schema": "https://turbo.build/schema.json",
	"tasks": {
		"test": {
			"cache": false
		},
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**"]
		},
		"dev": {
			"cache": false,
			"persistent": true,
			"passThroughEnv": ["E2E_TEST_OTP"]
		},
		"lint": {
			"dependsOn": ["^build"]
		}
	}
}
